{
  "name": "scripture-inline",
  "main": "scripts/docs-worker.ts",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "bible-sdk.com", "custom_domain": true },
    { "pattern": "www.bible-sdk.com", "custom_domain": true }
  ],
  "previews": {}
}
