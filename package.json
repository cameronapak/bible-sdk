{
  "name": "@faith-tools/bible-sdk",
  "version": "0.7.0",
  "description": "Unified Bible data SDK with async and Effect APIs, plus drop-in Scripture web components.",
  "license": "MIT",
  "author": "Cameron Pak (https://cameronpak.com)",
  "homepage": "https://bible-sdk.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cameronapak/bible-sdk.git"
  },
  "bugs": "https://github.com/cameronapak/bible-sdk/issues",
  "keywords": [
    "bible",
    "scripture",
    "web-components",
    "youversion",
    "bible-references"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/types/data.d.ts",
      "default": "./dist/data.js"
    },
    "./data/effect": {
      "types": "./dist/types/data-effect.d.ts",
      "default": "./dist/data/effect.js"
    },
    "./providers/helloao": {
      "types": "./dist/types/providers/helloao.d.ts",
      "default": "./dist/providers/helloao.js"
    },
    "./providers/youversion": {
      "types": "./dist/types/providers/youversion.d.ts",
      "default": "./dist/providers/youversion.js"
    },
    "./providers/fetch-bible": {
      "types": "./dist/types/providers/fetch-bible.d.ts",
      "default": "./dist/providers/fetch-bible.js"
    },
    "./providers/api-bible": {
      "types": "./dist/types/providers/api-bible.d.ts",
      "browser": null,
      "node": "./dist/providers/api-bible.js"
    },
    "./embed": "./dist/bible-sdk.js"
  },
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode lib && tsc -p tsconfig.build.json",
    "build:site": "vite build --mode site",
    "typecheck": "tsc --noEmit",
    "check:data-types": "tsc --ignoreConfig --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 --lib ES2022,DOM scripts/check-data-types.ts",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm check:data-types && pnpm build:site",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-cdn-version.ts"
  },
  "dependencies": {
    "@gracious.tech/fetch-client": "2.6.0",
    "@youversion/platform-core": "^2.16.0",
    "effect": "^4.1.2",
    "free-use-bible-api": "^1.16.0",
    "grab-bcv": "^0.1.8",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@americanbible/api-bible-sdk": "2.0.2",
    "@changesets/cli": "3.0.3",
    "@effect/vitest": "4.1.2",
    "@faith-tools/sensible-ui": "1.8.2",
    "@types/sanitize-html": "^2.16.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
