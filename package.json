{
  "name": "@faith-tools/scripture-inline",
  "version": "0.4.0",
  "description": "Drop-in Scripture for any web page: show a passage, pick a passage, or bring every Bible reference to life.",
  "license": "MIT",
  "author": "Cameron Pak (https://cameronpak.com)",
  "homepage": "https://github.com/cameronapak/scripture-inline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cameronapak/scripture-inline.git"
  },
  "bugs": "https://github.com/cameronapak/scripture-inline/issues",
  "keywords": [
    "bible",
    "scripture",
    "web-components",
    "youversion",
    "bible-references"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/types/data.d.ts",
      "default": "./dist/data.js"
    },
    "./providers/helloao": {
      "types": "./dist/types/providers/helloao.d.ts",
      "default": "./dist/providers/helloao.js"
    },
    "./providers/youversion": {
      "types": "./dist/types/providers/youversion.d.ts",
      "default": "./dist/providers/youversion.js"
    },
    "./providers/fetch-bible": {
      "types": "./dist/types/providers/fetch-bible.d.ts",
      "default": "./dist/providers/fetch-bible.js"
    },
    "./embed": "./dist/scripture-inline.js"
  },
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode lib && tsc -p tsconfig.build.json",
    "build:site": "vite build --mode site",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm build:site",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-cdn-version.ts"
  },
  "dependencies": {
    "@gracious.tech/fetch-client": "2.6.0",
    "@youversion/platform-core": "^2.16.0",
    "effect": "4.1.2",
    "free-use-bible-api": "^1.16.0",
    "grab-bcv": "^0.1.8",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@effect/vitest": "4.1.2",
    "@faith-tools/sensible-ui": "1.7.0",
    "@types/sanitize-html": "^2.16.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
